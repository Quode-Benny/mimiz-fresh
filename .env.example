# Prefer pnpm run setup: it creates ignored .env secrets and starts isolated containers.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3002
API_ORIGIN=http://127.0.0.1:4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# Must match the password embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-generated-local-password
DATABASE_URL=postgresql://mimiz:replace-with-generated-local-password@127.0.0.1:5433/mimiz_fresh
REDIS_URL=redis://127.0.0.1:6380
JWT_SECRET=replace-with-at-least-32-random-characters
MOCK_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Mock checkout sends real signed webhooks; no real money is collected.
PAYMENT_PROVIDER=mock
# The Paystack adapter is UNVERIFIED. Never enable live keys without sandbox validation.
PAYSTACK_SECRET_KEY=
SMS_PROVIDER=console
EMAIL_PROVIDER=console
# Demo customer code 123456; actual random codes still have expiry and attempt limits.
OTP_DEMO_MODE=true
# Explicit soft-launch opt-in only. Do not enable by default.
ALLOW_MOCK_IN_PRODUCTION=false
# Optional initial owner overrides. Defaults generate a password in ignored .local-admin.
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSWORD=

# Separate key for encrypted staff authenticator secrets. Generated by local setup.
TOTP_ENCRYPTION_KEY=
# Browser push: generate a VAPID pair and use a real owner-controlled contact in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SMS_SENDER_ID=Mimiz
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SMS_URL=
RESEND_API_KEY=
MAPS_PROVIDER=osm
# Identify your deployment and contact when using public Nominatim. See docs/maps.md.
GEOCODING_USER_AGENT=MimizFresh-local-demo/1.0
NOMINATIM_URL=https://nominatim.openstreetmap.org
GOOGLE_MAPS_API_KEY=
ROUTING_ROAD_FACTOR=1.4
ROUTING_SPEED_KMH=20
# Explicit first-install provisioning only (not normal API startup).
COMPANY_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Optional private object storage; local remains the zero-cost default.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=mimiz/

# Optional metadata-only error reporting; no telemetry is sent by console mode.
ERROR_PROVIDER=console
SENTRY_DSN=

# Local inference only. off keeps human-only support.
AI_CHAT_PROVIDER=off
OLLAMA_URL=http://127.0.0.1:11438
OLLAMA_MODEL=qwen2.5:0.5b
